<Application x:Class="CoDDedupe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:Spock.AppKit;assembly=Spock.AppKit">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Brushes first (Theme.Apply swaps this one for Dark.xaml), then the shared control styles. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Spock.AppKit;component/Themes/Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Spock.AppKit;component/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <kit:BoolToVisibilityConverter x:Key="BoolVis"/>
            <kit:BoolToVisibilityConverter x:Key="BoolVisInverse" Invert="True"/>
            <kit:InverseBoolConverter x:Key="Not"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
