<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CoDDedupe</AssemblyName>
    <RootNamespace>CoDDedupe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>CoD Dedupe</Product>
    <Authors>Spock</Authors>
    <Copyright>Copyright (c) 2026 Spock</Copyright>
    <Description>Keep Call of Duty installed through the Xbox app, Steam and Battle.net while storing the game data once.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plumbing shared with CoD Tweaker, vendored from github.com/SpockLSM/appkit with git subtree. -->
    <ProjectReference Include="..\..\shared\appkit\src\Spock.AppKit\Spock.AppKit.csproj" />
  </ItemGroup>

</Project>
