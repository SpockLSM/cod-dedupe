<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CoDDedupe</AssemblyName>
    <RootNamespace>CoDDedupe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>CoD Dedupe</Product>
    <Authors>Logan Miller</Authors>
    <Copyright>Copyright (c) 2026 Logan Miller</Copyright>
    <Description>Keep Call of Duty installed through the Xbox app, Steam and Battle.net while storing the game data once.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
