<Window x:Class="CoDDedupe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CoDDedupe.ViewModels"
        Title="CoD Dedupe" Width="1000" Height="780" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:InstallVm}">
            <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="4,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="main" IsChecked="{Binding IsMain}" IsEnabled="{Binding CanShare}"
                                 VerticalAlignment="Top" Margin="4,3,14,0" ToolTip="Make this the main store (its files are never modified)"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <Border Background="{DynamicResource InfoBg}" CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsMain, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="main: never modified" FontSize="11" Foreground="{DynamicResource InfoText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Root}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding Detail, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource WarnText}" Margin="0,2,0,0" Visibility="{Binding Note, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{DynamicResource WarnText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Warning, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="ThemeButton_Click" Margin="0,0,8,0" ToolTip="Switch between light and dark"/>
                <Button Content="Add folder..." Command="{Binding AddFolderCommand}" Margin="0,0,8,0" ToolTip="Add an install that wasn't found automatically"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="CoD Dedupe" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Text="Keep Call of Duty installed through the Xbox app, Steam and Battle.net while storing the game data on disk once."/>
            </StackPanel>
        </DockPanel>

        <!-- Banners -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Download" Command="{Binding OpenUpdateCommand}" Margin="0,0,8,0"/>
                        <Button Content="Not now" Command="{Binding DismissUpdateCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateText}" Foreground="{DynamicResource InfoText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding LaunchersRunning, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding CheckLaunchersCommand}" Padding="10,4"/>
                    <TextBlock Text="{Binding LaunchersText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Installs -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Call of Duty installs" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <ItemsControl ItemsSource="{Binding Installs}"/>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Unshare" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Give one store its own separate copies again"/>
                        <ComboBox ItemsSource="{Binding Installs}" SelectedItem="{Binding UnshareTarget}" MinWidth="130" Margin="0,0,8,0"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Go" Command="{Binding UnshareCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,0" ToolTip="Compare only; change nothing"/>
                        <Button Content="Share files" Style="{StaticResource PrimaryButton}" Command="{Binding ShareCommand}" MinWidth="130" Margin="0,0,8,0"/>
                        <Button Content="After an update" Command="{Binding AfterUpdateCommand}" Margin="0,0,8,0"
                                ToolTip="Share files, then have CoD Tweaker apply the preset chosen below"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"/>
                        <Button Content="Open logs" Command="{Binding OpenLogsCommand}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="After an update, also apply this CoD Tweaker preset:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearPresetCommand}" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Visibility="{Binding HasTweakerPreset, Converter={StaticResource BoolVis}}"/>
                    <Button DockPanel.Dock="Right" Content="Choose..." Command="{Binding BrowsePresetCommand}" Padding="10,4" FontSize="12"/>
                    <TextBlock Text="{Binding TweakerPresetDisplay}" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding TweakerPreset}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox IsChecked="{Binding WatchForUpdates}" Content="Watch for updates in the tray" FontSize="12"
                              ToolTip="Keeps running after you close the window, checks now and then whether an update left files that could be shared again, and tells you"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows, hidden in the tray" FontSize="12" Margin="18,0,0,0"
                              ToolTip="Adds CoD Dedupe to your Startup entries with --tray"/>
                </StackPanel>

                <Grid Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="8" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100"/>
                    <TextBlock Grid.Row="1" Text="{Binding Phase}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                </Grid>
                <Border Background="{DynamicResource OkBg}" BorderBrush="{DynamicResource OkBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Foreground="{DynamicResource OkText}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="LogBox_TextChanged"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="5" Margin="2,8,2,0" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="After every Call of Duty update, once every store has finished updating, click Share files (or After an update) to re-merge what the update split apart. A scheduled task can run CoDDedupe.exe --after-update instead."/>
    </Grid>
</Window>
